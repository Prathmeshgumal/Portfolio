# Postgres connection string. On Vercel, use Neon's *pooled* connection string.
DATABASE_URL=

# Admin login for /admin/inquiries
ADMIN_USERNAME=
# Generate with: pnpm admin:hash 'your-password'
ADMIN_PASSWORD_HASH=
# Random string of at least 32 characters, e.g. from: openssl rand -base64 48
SESSION_SECRET=

# Optional: email me when a new inquiry arrives (https://resend.com, free tier)
RESEND_API_KEY=
NOTIFY_EMAIL=
